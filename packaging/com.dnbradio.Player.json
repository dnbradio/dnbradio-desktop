{
  "app-id": "com.dnbradio.Player",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "dnbradio",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [{
    "name": "dnbradio",
    "buildsystem": "cmake-ninja",
    "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=OFF"],
    "sources": [{"type": "dir", "path": "..", "skip": [".git", "build", "dist", ".scratch", ".flatpak-builder"]}]
  }]
}
